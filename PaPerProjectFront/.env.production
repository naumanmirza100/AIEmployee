# Loaded by Vite for `npm run build` (mode=production), overriding .env.
#
# .env is gitignored and holds the localhost value for development, so without
# this file a production build bakes http://localhost:8000/api into the bundle
# and every API call fails in the browser. Committed deliberately: this is a
# public URL, not a secret, and keeping it here means anyone can produce a
# correct production build without knowing a local convention.
VITE_API_URL=https://api.payperproject.com/api

# The backend ROOT, with no /api suffix. Two candidate-facing pages
# (ApplicationTrackerPage, CandidatePortalPage) build links straight off it:
# interview slot-selection URLs and CV download links, which Django serves at
# the root, not under /api. Leave it unset and a production build silently
# falls back to http://localhost:8000 and those links break for candidates.
# Matches BACKEND_URL in the server's own .env, which generates the same
# slot-selection links in emails.
VITE_BACKEND_URL=https://api.payperproject.com
