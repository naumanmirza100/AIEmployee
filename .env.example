# ==========================================================================
# Copy this file to ".env" (same folder as manage.py) and fill in real values.
# The ones marked REQUIRED are needed just to start the server + DB.
# Everything else enables optional features (AI agents, email, payments, AWS).
# ==========================================================================

# --- Database (REQUIRED) --------------------------------------------------
# You have "ODBC Driver 17 for SQL Server" installed, so override the default
# (which is Driver 18) with the line below.

EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DEVICE = cpu

# Which database backend to use. `mysql` (or `mariadb`) is what the VPS and the
# docker compose stack run; anything else, or unset, selects SQL Server.
# Note the code's own default is mssql — see settings.py — so this line is what
# makes MariaDB the default for a fresh checkout.
DB_ENGINE=mysql

# --- MariaDB / MySQL (used when DB_ENGINE=mysql) --------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_db_username
DB_PASSWORD=your_db_password
# Read only by the `db` service in docker-compose.yml, to initialise the
# MariaDB container on first boot. The app never logs in as root — it uses
# DB_USER / DB_PASSWORD above, which the container creates for it.
# Under docker compose, DB_HOST/DB_PORT are overridden to db:3306.
# No `$` in this value or in DB_PASSWORD: compose interpolates them, so a `$`
# is read as a variable and the password silently arrives wrong.
DB_ROOT_PASSWORD=choose_a_long_random_root_password

# --- SQL Server (uncomment and set DB_ENGINE to anything but mysql) -------
# DB_DRIVER=ODBC Driver 17 for SQL Server
# DB_HOST=localhost
# DB_PORT=1433
# USE_SQL_SERVER=1
# Set to 1 to use Windows Integrated Auth instead of DB_USER/DB_PASSWORD:
# USE_WINDOWS_AUTH=0

# --- Celery / Redis (optional; needed for background jobs) ----------------
USE_REDIS=1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Dev output -----------------------------------------------------------
# Print the EMAIL/CELERY configuration banners on startup. Off by default: settings
# are imported by every manage.py command, so the banners otherwise appear on top of
# migrate/shell/test output too. Real warnings print regardless of this flag.
# SHOW_STARTUP_BANNER=1

# --- URLs -----------------------------------------------------------------
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SITE_URL=http://localhost:8000

# --- Encryption of stored API keys ----------------------------------------
# Must be IDENTICAL on every machine that uses the same database, or machines
# can't read each other's saved keys. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# then run: python manage.py reencrypt_secrets --check   and   python manage.py reencrypt_secrets
# FIELD_ENCRYPTION_KEY=
# Older keys still accepted for reading (comma-separated), e.g. after a rotation:
# FIELD_ENCRYPTION_KEY_FALLBACKS=
# Set on real servers — but only AFTER FIELD_ENCRYPTION_KEY is set and
# reencrypt_secrets has run, or every stored API key becomes unreadable.
# DJANGO_SECRET_KEY=

# --- Security / deployment ------------------------------------------------
# DEBUG: unset = on for `manage.py runserver`, off for everything else
# (gunicorn, Celery, commands). Never set 1 on a public server: it shows full
# error pages, settings included, and opens CORS to every website.
# DJANGO_DEBUG=0
# Hosts this backend answers to (comma-separated). Unset with DEBUG off:
# localhost + the host of SITE_URL / BACKEND_URL.
# DJANGO_ALLOWED_HOSTS=api.example.com
# Extra origins allowed to call the API when DEBUG is off (FRONTEND_URL is added automatically).
# CORS_ALLOWED_ORIGINS=https://app.example.com
# With DEBUG off, session/CSRF cookies are HTTPS-only. Set 0 only for a plain-HTTP server.
# DJANGO_SECURE_COOKIES=1
# Set 1 only if a proxy in front terminates HTTPS and sends X-Forwarded-Proto.
# DJANGO_BEHIND_HTTPS_PROXY=0
# Opt-in once HTTPS is confirmed working:
# DJANGO_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=3600

# --- Database connections / background jobs -------------------------------
# The Hostinger DB user may open only 500 connections an hour, shared by every
# machine using it; past that, every connection (logins too) is refused for up to an hour.
# Seconds a DB connection is reused (max 570, below the 600 s server timeout).
# DB_CONN_MAX_AGE=540
# Don't start Celery with runserver / don't run the SDR scheduler here:
# CELERY_AUTOSTART=false
# SDR_SCHEDULER_ENABLED=false

# --- Email (optional) -----------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- AI providers (optional; enable the agents) ---------------------------
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_REC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
EMBEDDING_PROVIDER=openai

# --- Stripe payments (optional) -------------------------------------------
# Full setup, webhook registration and the go-live sequence: docs/STRIPE.md
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Per-destination AND per-mode. The value printed by
#   stripe listen --forward-to localhost:8000/api/modules/stripe-webhook
# is NOT the value of a registered dashboard endpoint, and test is not live.
# Using the wrong one gives 400s and silently unsynced subscriptions.
STRIPE_WEBHOOK_SECRET=

# --- AWS S3 storage (optional) --------------------------------------------
# Set USE_S3=True to store uploaded files (e.g. candidate CVs) on S3.
# When False (or unset), files are stored locally under media/.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# --- Google OAuth (optional; meeting/calendar agent) ----------------------
# Platform OAuth app used for the per-company "Connect Google Calendar" flow
# (Company Profile -> Integrations). Create an OAuth client in Google Cloud
# Console, enable the Calendar API, and whitelist the redirect URI below.
GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret_here
GOOGLE_REFRESH_TOKEN=
# Must exactly match an "Authorized redirect URI" in the Google Cloud OAuth app.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/company/integrations/google-calendar/callback
